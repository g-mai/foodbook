---
import Layout from '@/layouts/Layout.astro';
import { RecipeBrowser } from '@/components/recipe-browser';
import { foodbook } from '@/lib/foodbook';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';

const recipes = await getCollection('recipes');
const browserRecipes = await Promise.all(
  recipes.map(async (recipe) => {
    const image = await getImage({
      src: recipe.data.image,
      width: 720,
      height: 540,
      format: 'webp',
    });

    return {
      id: recipe.id,
      title: recipe.data.title,
      addedAt: recipe.data.addedAt,
      language: recipe.data.language,
      categories: recipe.data.categories,
      tags: recipe.data.tags,
      ingredients: recipe.data.ingredients.map(({ name }) => name),
      prepMinutes: recipe.data.prepMinutes ?? null,
      cookMinutes: recipe.data.cookMinutes ?? null,
      servings: recipe.data.servings ?? null,
      image: {
        src: image.src,
        width: 720,
        height: 540,
        alt: recipe.data.imageAlt,
      },
    };
  }),
);
---

<Layout title={foodbook.name} description={foodbook.description}>
  <main id="top" class="cookbook-shell">
    <header class="cookbook-header">
      <a
        href="/"
        class="wordmark w-fit rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        <svg
          aria-hidden="true"
          class="wordmark-icon"
          width="26"
          height="26"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 3H20v19H6.5A2.5 2.5 0 0 1 4 19.5v-14A2.5 2.5 0 0 1 6.5 3Z" />
          <path d="M9 7h6M9 11h4" />
        </svg>
        <span>{foodbook.name}</span>
      </a>
    </header>

    <RecipeBrowser
      recipes={browserRecipes}
      tagline={foodbook.tagline}
      client:load
    />
    <noscript>
      <style is:inline>
        .suggestion-shuffle {
          display: none;
        }
        .suggestion-print[data-pending='true'] {
          visibility: visible;
        }
      </style>
      <p class="text-sm text-muted-foreground">
        Search and filters need JavaScript. All recipes are listed below.
      </p>
    </noscript>
    <footer class="cookbook-footer">
      <span>{foodbook.name}</span>
      <span class="handwritten">Keep something delicious.</span>
      <a href="#top">
        Back to top
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 19V5m-6 6 6-6 6 6" />
        </svg>
      </a>
    </footer>
  </main>
</Layout>
